VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FUNCTIONS_REGION=us-central1
VITE_GOOGLE_MAPS_BROWSER_KEY=your-restricted-browser-maps-key
# Optional real map ID enables AdvancedMarkerElement; omit for legacy markers.
VITE_GOOGLE_MAPS_MAP_ID=

# Optional: initialize Firebase App Check only when this public site key is set.
# Backend enforcement is rolled out independently using ENFORCE_APP_CHECK=true.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional local development. Start Firebase Auth/Firestore/RTDB/Functions emulators first.
# Ports: Auth 9099, Firestore 8080, RTDB 9000, Functions 5001.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
