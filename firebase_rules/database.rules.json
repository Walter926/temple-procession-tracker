{
  "rules": {
    ".read": false,
    ".write": false,

    "liveLocations": {
      "$eventId": {
        "$groupId": {
          ".read": "auth != null",
          ".write": "auth != null && newData.child('userId').val() == auth.uid",
          ".validate": "newData.hasChildren(['userId', 'latitude', 'longitude', 'recordedAt'])"
        }
      }
    },

    "trackingStatus": {
      "$eventId": {
        "$groupId": {
          ".read": "auth != null",
          ".write": "auth != null && newData.child('userId').val() == auth.uid"
        }
      }
    }
  }
}