rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().isActive == true && profile().get('deleting', false) == false; }
    function admin() { return active() && profile().role == 'admin'; }
    function eventData(id) { return get(/databases/$(database)/documents/events/$(id)).data; }
    function routeData(id) { return get(/databases/$(database)/documents/routes/$(id)).data; }
    function ownsEvent(id) { return active() && profile().role == 'organizer' && eventData(id).organizerId == request.auth.uid; }
    function manager(id) { return admin() || ownsEvent(id); }
    function assignedToEvent(id) {
      return active() && profile().role == 'teamLeader' && profile().get('assignedGroupId','') != ''
        && get(/databases/$(database)/documents/groups/$(profile().assignedGroupId)).data.eventId == id
        && request.auth.uid in [
          get(/databases/$(database)/documents/groups/$(profile().assignedGroupId)).data.leaderUserId,
          get(/databases/$(database)/documents/groups/$(profile().assignedGroupId)).data.get('backupLeaderUserId','')];
    }
    function member(id) { return active() && exists(/databases/$(database)/documents/memberships/$(id + '_' + request.auth.uid))
      && get(/databases/$(database)/documents/memberships/$(id + '_' + request.auth.uid)).data.uid == request.auth.uid
      && get(/databases/$(database)/documents/memberships/$(id + '_' + request.auth.uid)).data.eventId == id
      && get(/databases/$(database)/documents/memberships/$(id + '_' + request.auth.uid)).data.get('isActive',true) == true
      && !(get(/databases/$(database)/documents/memberships/$(id + '_' + request.auth.uid)).data.get('status','active') in ['removed','revoked']); }
    function published(id) {
      return exists(/databases/$(database)/documents/publicEvents/$(id));
    }
    function publicViewer() { return !signedIn() || active(); }
    function eventReader(id) {
      return active() && (manager(id) || member(id) || assignedToEvent(id)
        || (eventData(id).isPublic == true && eventData(id).status in ['scheduled','active']));
    }
    function routeReader(id) {
      return eventReader(routeData(id).eventId) || (publicViewer() && published(routeData(id).eventId)
        && get(/databases/$(database)/documents/publicEvents/$(routeData(id).eventId)).data.routeId == id);
    }
    function validProfile(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
        && (data.get('photoUrl',null) == null || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && (data.get('phoneNumber',null) == null || (data.phoneNumber is string && data.phoneNumber.size() <= 40));
    }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','displayName','role','isActive','photoUrl','phoneNumber','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['email','displayName','role','isActive','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['organizer','teamLeader','teamMember'] && request.resource.data.isActive == true
        && request.resource.data.createdAt is timestamp
        && (request.resource.data.get('updatedAt',null) == null || request.resource.data.updatedAt is timestamp)
        && validProfile(request.resource.data);
      // An inactive account may read only its own profile so clients can enforce deactivation.
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if active() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','phoneNumber','updatedAt'])
        && request.resource.data.updatedAt == request.time && validProfile(request.resource.data);
      allow delete: if false;
    }
    match /events/{id} {
      allow read: if active() && (
        admin() || (profile().role == 'organizer' && resource.data.organizerId == request.auth.uid)
        || member(id) || assignedToEvent(id)
        || (resource.data.isPublic == true && resource.data.status in ['scheduled','active']));
      allow write: if false;
    }
    match /eventContacts/{id} { allow read: if manager(id); allow write: if false; }
    match /publicEvents/{id} { allow read: if publicViewer(); allow write: if false; }
    match /routes/{id} {
      allow read: if eventReader(resource.data.eventId) || (publicViewer() && published(resource.data.eventId)
        && get(/databases/$(database)/documents/publicEvents/$(resource.data.eventId)).data.routeId == id);
      allow write: if false;
    }
    match /stopPoints/{id} { allow read: if routeReader(resource.data.routeId); allow write: if false; }
    match /routeSegments/{id} { allow read: if routeReader(resource.data.routeId); allow write: if false; }
    match /groups/{id} {
      allow read: if eventReader(resource.data.eventId);
      allow create, delete: if false;
      allow update: if active() && profile().role == 'teamLeader' && profile().get('assignedGroupId','') == id
        && resource.data.leaderUserId == request.auth.uid && eventData(resource.data.eventId).status == 'active'
        && request.resource.data.status in ['waiting','preparing','moving','stopped','delayed','arrived','completed','emergency']
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','statusUpdatedAt'])
          && request.resource.data.statusUpdatedAt == request.time)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','lastLocationUpdateAt'])
          && request.resource.data.lastLocationUpdateAt == request.time));
    }
    match /memberships/{id} {
      allow read: if active() && (resource.data.uid == request.auth.uid || manager(resource.data.eventId));
      allow write: if false;
    }
    match /accessCodes/{id} {
      allow read: if manager(resource.data.eventId) || (active() && profile().role == 'teamLeader'
        && profile().get('assignedGroupId','') == resource.data.groupId && resource.data.groupId != ''
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.leaderUserId == request.auth.uid);
      allow write: if false;
    }
    match /publicAnnouncements/{id} {
      allow read: if manager(resource.data.eventId) || (publicViewer() && resource.data.isActive == true && published(resource.data.eventId));
      allow write: if false;
    }
    match /announcements/{id} { allow read: if manager(resource.data.eventId); allow write: if false; }
    match /groupProgress/{id} { allow read: if eventReader(resource.data.eventId); allow write: if false; }
    match /stopArrivals/{id} { allow read: if eventReader(resource.data.eventId); allow write: if false; }
    match /arrivalNotifications/{id} { allow read: if manager(resource.data.eventId); allow write: if false; }
    match /locationUpdates/{id} { allow read: if eventReader(resource.data.eventId); allow write: if false; }
    match /locationHistory/{id} { allow read: if manager(resource.data.eventId); allow write: if false; }
    match /collisionAlerts/{id} { allow read: if manager(resource.data.eventId); allow write: if false; }
    match /routeSuggestions/{id} { allow read: if manager(resource.data.eventId); allow write: if false; }
    match /collisionInstructions/{id} { allow read: if manager(resource.data.eventId); allow write: if false; }
    match /notifications/{id} {
      allow read: if active() && (resource.data.uid == request.auth.uid || admin() || ownsEvent(resource.data.eventId));
      allow write: if false;
    }
    match /collisionWarnings/{id} {
      allow read: if active() && (resource.data.uid == request.auth.uid || manager(resource.data.eventId));
      allow write: if false;
    }
    match /routeInstructions/{id} {
      allow read: if active() && (resource.data.uid == request.auth.uid || manager(resource.data.eventId));
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
