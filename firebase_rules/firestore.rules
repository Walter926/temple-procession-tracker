rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isOrganizer() {
      return signedIn() &&
        (
          userRole() == 'admin' ||
          userRole() == 'organizer'
        );
    }

    function isTeamLeaderOrHigher() {
      return signedIn() &&
        (
          userRole() == 'admin' ||
          userRole() == 'organizer' ||
          userRole() == 'teamLeader'
        );
    }

    match /users/{userId} {
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'viewer';

      allow read: if signedIn() &&
        (
          request.auth.uid == userId ||
          isOrganizer()
        );

      allow update: if signedIn() &&
        (
          (
            request.auth.uid == userId &&
            request.resource.data.role == resource.data.role
          ) ||
          isAdmin()
        );

      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizer();
    }

    match /routes/{routeId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizer();
    }

    match /routeSegments/{segmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizer();
    }

    match /stopPoints/{stopPointId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizer();
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizer();
    }

    match /accessCodes/{accessCodeId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizer();
    }

    match /locationUpdates/{locationUpdateId} {
      allow read: if signedIn();

      allow create: if isTeamLeaderOrHigher() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /locationHistory/{historyId} {
      allow read: if signedIn();
      allow create: if isTeamLeaderOrHigher();
      allow update, delete: if isOrganizer();
    }

    match /collisionAlerts/{alertId} {
      allow read: if signedIn();
      allow create: if isTeamLeaderOrHigher();
      allow update, delete: if isOrganizer();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizer();
    }

    match /routeSuggestions/{suggestionId} {
      allow read: if signedIn();
      allow create, update, delete: if isOrganizer();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}