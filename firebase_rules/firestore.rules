rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return isSignedIn()
        && currentUserRole() == 'admin';
    }

    function isOrganizer() {
      return isSignedIn()
        && currentUserRole() == 'organizer';
    }

    function isManagement() {
      return isAdmin() || isOrganizer();
    }

    match /users/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'teamMember'
        && request.resource.data.email == request.auth.token.email;

      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || isManagement()
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.createdAt == resource.data.createdAt
        );

      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn()
        || resource.data.isPublic == true;

      allow create, update, delete: if isManagement();
    }

    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /routeSegments/{segmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /stopPoints/{stopPointId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /accessCodes/{accessCodeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /locationUpdates/{locationUpdateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /locationHistory/{historyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /collisionAlerts/{alertId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /routeSuggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagement();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}